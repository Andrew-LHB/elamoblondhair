---
interface Props { direction?: 'up-right' | 'down' | 'left' | 'right'; }
const { direction = 'up-right' } = Astro.props;
const rotation = { 'up-right': '-45', down: '90', left: '180', right: '0' }[direction];
---
<svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><g transform={`rotate(${rotation} 12 12)`}><path d="M5 12h14m-6-6 6 6-6 6" /></g></svg>
