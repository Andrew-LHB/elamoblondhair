---
import { Image } from 'astro:assets';
import Arrow from '../components/Arrow.astro';
import h1 from '../assets/hair-1.png';
import h2 from '../assets/hair-2.png';
import h3 from '../assets/hair-3.png';
import h4 from '../assets/hair-4.png';
import h5 from '../assets/hair-5.png';
import h6 from '../assets/hair-6.png';
import portrait from '../assets/hair-7.png';
import h8 from '../assets/hair-8.png';
import h9 from '../assets/hair-9.png';
import h10 from '../assets/hair-10.png';
const works = [
 {image:h10,title:'Soft dimension',category:'Blonde',label:'Blonde · dimensional color'},
 {image:h9,title:'A little more fire',category:'Color',label:'Color · copper & red'},
 {image:h5,title:'The golden hour',category:'Blonde',label:'Blonde · highlights'},
 {image:h6,title:'Length, beautifully blended',category:'Extensions',label:'Extensions · detail'},
 {image:h3,title:'Berry beautiful',category:'Color',label:'Color · vivid dimension'},
 {image:h8,title:'Effortless blonde',category:'Blonde',label:'Blonde · soft waves'},
 {image:h2,title:'Rich in color',category:'Color',label:'Color · burgundy'},
 {image:h1,title:'Warm & luminous',category:'Color',label:'Color · golden tones'},
 {image:h4,title:'Light, from root to end',category:'Blonde',label:'Blonde · long hair'},
];
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Elvira Mor | Hair Color & Extensions in Portland, OR</title>
  <meta name="description" content="Hair color, dimensional blondes, AirTouch, balayage and hair extensions with Elvira Mor. Serving Portland and the surrounding areas. Call or text 971-507-3746." />
  <meta name="theme-color" content="#f6f3ec" />
  <link rel="canonical" href="https://emorportlandhair.com/" />
  <meta property="og:url" content="https://emorportlandhair.com/" />
  <meta property="og:title" content="Elvira Mor — Hair that feels like you." />
  <meta property="og:description" content="Personalized color & extensions in Portland and the surrounding areas. Discover Elvira’s work and get in touch." />
  <meta property="og:type" content="website" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'HairSalon',name:'Elvira Mor — Hair Color & Extensions',telephone:'+19715073746',email:'elvira_mor@live.com',address:{'@type':'PostalAddress',streetAddress:'941 NE Hogan Dr',addressLocality:'Gresham',addressRegion:'OR',postalCode:'97030',addressCountry:'US'},sameAs:['https://www.instagram.com/elamoblondhair/']})} />
 </head>
 <body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="header wrap">
   <a class="brand" href="#" aria-label="Elvira Mor home">elvira mor<span>HAIR ARTIST · COLORIST</span></a>
   <nav aria-label="Main navigation"><a href="#about">Meet Elvira</a><a href="#services">Services</a><a href="#work">The portfolio</a></nav>
   <a class="button small" href="#contact">Let’s talk hair <span aria-hidden="true"><Arrow /></span></a>
  </header>
  <main id="main">
   <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-photo"><Image src={portrait} alt="Elvira Mor styling a client’s blonde hair in the salon" widths={[480,720,960]} sizes="(max-width: 700px) 100vw, 43vw" loading="eager" fetchpriority="high" format="webp" /><div class="photo-label">GOOD HAIR. GOOD ENERGY.</div></div>
    <div class="hero-copy" id="about">
     <p class="eyebrow"><span class="dot"></span> PORTLAND & SURROUNDING AREAS</p>
     <h1 id="hero-title">Hi, I’m Elvira.<br /><em>Your hair artist.</em></h1>
     <div class="intro biography"><p>I’m a licensed hairstylist. I studied hair design and began my career in Germany before continuing my career in the United States.</p><p>I incorporate the latest international trends, innovations, and techniques in hair coloring and styling, while placing great importance on gentle hair care.</p><p>I believe that beautiful, healthy, well-cared-for hair is the key to a positive outlook and success.</p></div>
     <a class="button" href="sms:+19715073746">Text Elvira about your hair <span aria-hidden="true"><Arrow /></span></a>
     <a class="text-link hero-link" href="#work">Explore my work <Arrow direction="down" /></a>
     <div class="hero-bottom"><span>PERSONAL COLOR. PERSONAL CARE.</span><span>PORTLAND & SURROUNDING AREAS</span></div>
    </div>
   </section>
   <div class="specialties" aria-label="Specialties"><span>DIMENSIONAL BLONDES</span><i aria-hidden="true"></i><span>EFFORTLESS COLOR</span><i aria-hidden="true"></i><span>SEAMLESS EXTENSIONS</span><i aria-hidden="true"></i><span>HAIR THAT FEELS LIKE YOU</span></div>
   <section class="services section" id="services"><div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">MADE FOR YOUR HAIR</p><h2>A little change.<br /><em>A beautiful difference.</em></h2></div><p>Every head of hair tells a different story.<br />Let’s find what works for yours.</p></div>
    <div class="service-grid">
     <article><div class="service-top"><span>01 / COLOR</span></div><h3>Color with<br />dimension.</h3><p>Soft, sunlit tones or a statement shade. Personalized coloring with depth, movement, and a finish that feels like you.</p><ul><li>AirTouch & HandTouch</li><li>Balayage & highlights</li><li>Complex hair coloring</li></ul><a href="sms:+19715073746" class="text-link">Talk color <span aria-hidden="true"><Arrow /></span></a></article>
     <article><div class="service-top"><span>02 / EXTENSIONS</span></div><h3>Your hair.<br />A little more.</h3><p>Added length, fuller hair, and a beautiful blend. Explore an extension method suited to your hair and your goals.</p><ul><li>Brazilian Knots</li><li>I-tip & Weft</li><li>Length & added volume</li></ul><a href="sms:+19715073746" class="text-link">Explore extensions <span aria-hidden="true"><Arrow /></span></a></article>
     <article><div class="service-top"><span>03 / CARE</span></div><h3>Good hair,<br />beyond the chair.</h3><p>Personal attention and hair care guidance to help you care for your color and keep your hair feeling its best.</p><ul><li>Personal hair consultation</li><li>Hair care guidance</li><li>Professional hair care brands</li></ul><a href="sms:+19715073746" class="text-link">Let’s talk care <span aria-hidden="true"><Arrow /></span></a></article>
    </div>
    <p class="pricing-note"> As individual as you are. Pricing is tailored to your hair, your service, and your desired result. Get in touch for a personal quote.</p>
   </div></section>
   <section class="portfolio wrap section" id="work">
    <div class="section-heading"><div><p class="eyebrow">THE PORTFOLIO</p><h2>Real hair.<br /><em>Beautiful possibilities.</em></h2></div><a class="text-link" href="https://www.instagram.com/elamoblondhair/" target="_blank" rel="noreferrer">More on Instagram <span aria-hidden="true"><Arrow /></span></a></div>
    <div class="filters" role="group" aria-label="Filter portfolio">{['All work','Blonde','Color','Extensions'].map((filter,i)=><button data-filter={filter} aria-pressed={i===0}>{filter}<span aria-hidden="true">{i===0?'09':i===1?'04':i===2?'04':'01'}</span></button>)}</div>
    <div class="gallery">{works.map((work,i)=><figure data-category={work.category}><button class="image-button" data-index={i} aria-label={`Enlarge ${work.title}`}><Image src={work.image} alt={work.label} widths={[360,600,900]} sizes="(max-width: 550px) 90vw, (max-width: 900px) 45vw, 30vw" format="webp" loading="lazy" /><span class="image-open" aria-hidden="true"><Arrow /></span></button><figcaption><span>{work.title}</span><span>{work.category}</span></figcaption></figure>)}</div>
    <p class="portfolio-count" aria-live="polite">Showing all 9 looks</p>
   </section>
   <section class="contact" id="contact"><div class="wrap contact-grid"><div><p class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</p><h2>Let’s make<br /><em>good hair happen.</em></h2><p>Have a look in mind? Send me a message with your hair goals or a little inspiration. We’ll take it from there.</p><div class="contact-buttons"><a class="button cream" href="sms:+19715073746">Text Elvira <span aria-hidden="true"><Arrow /></span></a><a class="call-link" href="tel:+19715073746">Or call 971-507-3746 <span aria-hidden="true"><Arrow /></span></a></div></div><div class="contact-details"><div><span class="eyebrow">COME FIND ME</span><a href="https://www.google.com/maps/search/?api=1&query=941+NE+Hogan+Dr+Gresham+OR+97030" target="_blank" rel="noreferrer">941 NE Hogan Dr <span aria-hidden="true"><Arrow /></span><br />Gresham, OR 97030</a><p>Serving Portland & surrounding areas<br />Visits by appointment</p></div><div><span class="eyebrow">SAY HELLO</span><a href="mailto:elvira_mor@live.com">elvira_mor@live.com <span aria-hidden="true"><Arrow /></span></a><a href="https://www.instagram.com/elamoblondhair/" target="_blank" rel="noreferrer">@elamoblondhair <span aria-hidden="true"><Arrow /></span></a></div></div></div></section>
  </main>
  <footer class="wrap"><a href="#" class="brand">elvira mor<span>HAIR ARTIST · COLORIST</span></a><p>Color with intention. Hair with personality.</p><span>© {new Date().getFullYear()} Elvira Mor</span></footer>
  <dialog class="lightbox" aria-label="Portfolio photograph"><button class="close-lightbox" aria-label="Close photograph">Close ×</button><img src="" alt="" /><p></p><div class="lightbox-controls"><button data-step="-1" aria-label="Previous photograph"><Arrow direction="left" /> Previous</button><button data-step="1" aria-label="Next photograph">Next <Arrow direction="right" /></button></div></dialog>
  <script>
   const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
   const figures = document.querySelectorAll<HTMLElement>('.gallery figure');
   filters.forEach(button => button.addEventListener('click', () => {
    filters.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
    let count = 0;
    figures.forEach(figure => { figure.hidden = button.dataset.filter !== 'All work' && figure.dataset.category !== button.dataset.filter; if (!figure.hidden) count++; });
    document.querySelector('.portfolio-count')!.textContent = button.dataset.filter === 'All work' ? 'Showing all 9 looks' : `Showing ${count} ${button.dataset.filter!.toLowerCase()} ${count === 1 ? 'look' : 'looks'}`;
   }));
   const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
   let current = 0;
   const showPhoto = (index: number) => {
    current = (index + figures.length) % figures.length;
    const figure = figures[current]; const source = figure.querySelector('img')!;
    const image = dialog.querySelector('img')!;
    image.src = source.currentSrc || source.src; image.alt = source.alt;
    dialog.querySelector('p')!.textContent = `${figure.querySelector('figcaption span')!.textContent} — ${current + 1} / ${figures.length}`;
   };
   document.querySelectorAll<HTMLButtonElement>('[data-index]').forEach(button => button.addEventListener('click', () => {showPhoto(Number(button.dataset.index));dialog.showModal();}));
   dialog.querySelector('.close-lightbox')!.addEventListener('click', () => dialog.close());
   dialog.addEventListener('click', event => {if(event.target === dialog) dialog.close();});
   dialog.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(button => button.addEventListener('click', () => showPhoto(current + Number(button.dataset.step))));
   dialog.addEventListener('keydown', event => {if (event.key === 'ArrowRight') showPhoto(current+1); if (event.key === 'ArrowLeft') showPhoto(current-1);});
   dialog.addEventListener('close',()=>document.body.classList.remove('modal-open'));
   new MutationObserver(()=>document.body.classList.toggle('modal-open',dialog.open)).observe(dialog,{attributes:true,attributeFilter:['open']});
  </script>
 </body>
</html>
<style is:global>
 :root{--paper:#f6f3ec;--ink:#322c29;--muted:#70645c;--wine:#682e38;--line:#d9d1c5;--serif:'Playfair Display',Georgia,serif;--sans:'DM Sans',Arial,sans-serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:30px}body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:15px;-webkit-font-smoothing:antialiased}body.modal-open{overflow:hidden}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}a,button{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible{outline:3px solid #b87d38;outline-offset:5px}::selection{background:#dfc5bc}.wrap{max-width:1336px;width:calc(100% - 112px);margin-inline:auto}.header{height:120px;display:flex;align-items:center;justify-content:space-between;gap:25px}.brand{font-family:var(--serif);font-size:35px;letter-spacing:-1.8px;line-height:1.1}.brand span{display:block;font-family:var(--sans);font-size:8px;font-weight:500;letter-spacing:2.5px;margin-top:10px}.header nav{display:flex;gap:35px;font-size:13px}.header nav a{padding:12px 0;position:relative}.header nav a:after{content:'';position:absolute;bottom:5px;left:0;width:0;height:1px;background:var(--wine);transition:width .2s}.header nav a:hover:after{width:100%}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:40px;min-height:55px;padding:17px 25px;background:var(--wine);color:var(--paper);font-size:13px;transition:background .2s}.button:hover{background:#4c2028}.button span{font-size:22px;line-height:1}.button.small{min-height:45px;padding:12px 19px;gap:28px}.hero{display:grid;grid-template-columns:1fr 1.18fr;min-height:640px;margin-top:12px;margin-bottom:56px}.hero-photo{position:relative;min-width:0}.hero-photo>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 36%}.photo-label{position:absolute;bottom:22px;left:22px;background:var(--paper);display:flex;gap:13px;align-items:center;padding:13px 19px;font-size:9px;letter-spacing:1.5px}.spark{font-size:24px;color:var(--wine)}.hero-copy{padding:30px 0 0 9%;display:flex;align-items:flex-start;flex-direction:column}.eyebrow{font-size:10px;font-weight:500;letter-spacing:2px;line-height:1.8;margin:0 0 25px}.dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--wine);margin-right:10px;vertical-align:middle}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:var(--serif);font-weight:400}h1{font-size:clamp(54px,5.8vw,86px);line-height:1.12;letter-spacing:-3.8px;margin-bottom:25px}em{font-weight:400;color:var(--wine)}.intro{font-size:15px;color:var(--muted);line-height:1.8;margin-bottom:26px}.text-link{font-size:13px;display:inline-flex;justify-content:space-between;align-items:center;gap:25px;padding-block:10px;border-bottom:1px solid var(--ink);transition:color .2s}.text-link:hover{color:var(--wine)}.hero-link{margin-top:16px;border:0;font-size:12px}.hero-bottom{margin-top:auto;width:100%;padding-top:32px;padding-bottom:8px;display:flex;justify-content:space-between;gap:10px;font-size:8px;letter-spacing:1.3px;color:var(--muted)}.specialties{background:#ece7dd;border-block:1px solid var(--line);display:flex;justify-content:center;align-items:center;gap:4%;padding:24px 25px;font-size:10px;letter-spacing:1.8px}.specialties i{height:18px;width:1px;background:#c8b9aa;flex-shrink:0}.section{padding-block:105px}h2{font-size:clamp(36px,3.6vw,52px);line-height:1.2;letter-spacing:-1.5px;margin-bottom:0}.about{display:grid;grid-template-columns:1fr 1fr;gap:12%}.about-body{padding-top:6px}.about-body p{font-size:15px;line-height:1.85;color:var(--muted);max-width:475px;margin-bottom:18px}.about-body .text-link{margin-top:5px}.services{background:#ede8df}.section-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:45px;margin-bottom:50px}.section-heading>p{font-size:14px;line-height:1.8;color:var(--muted);margin-bottom:4px}.section-heading .eyebrow{margin-bottom:17px}.service-grid{display:grid;grid-template-columns:repeat(3,1fr)}.service-grid article{padding:0 35px;border-left:1px solid #cfc5b7}.service-grid article:first-child{border-left:0;padding-left:0}.service-grid article:last-child{padding-right:0}.service-top{display:flex;justify-content:space-between;align-items:center;color:var(--wine);font-size:9px;letter-spacing:1.4px;margin-bottom:24px}h3{font-size:35px;line-height:1.2;letter-spacing:-.8px;margin-bottom:20px}.service-grid p{color:var(--muted);line-height:1.8;font-size:13px;max-width:320px;min-height:94px}.service-grid ul{list-style:none;padding:0;margin:24px 0;font-size:12px;line-height:2.1}.service-grid li:before{content:'—';color:#9c8172;margin-right:12px}.service-grid .text-link{font-size:12px}.pricing-note{margin:45px 0 0;border-top:1px solid #cfc5b7;padding-top:24px;color:var(--muted);font-size:12px;line-height:1.8;display:flex;gap:13px;align-items:center}.pricing-note span{font-size:23px;color:var(--wine)}.filters{display:flex;gap:9px;margin:-10px 0 30px;flex-wrap:wrap}.filters button{border:1px solid var(--line);color:var(--muted);background:transparent;border-radius:2px;padding:13px 19px;font-size:12px;min-height:44px;transition:background .2s,color .2s}.filters button span{font-size:9px;margin-left:18px}.filters button[aria-pressed=true]{background:var(--wine);border-color:var(--wine);color:var(--paper)}.filters button:hover{border-color:var(--wine)}.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:35px 25px}.gallery figure{margin:0;min-width:0}.gallery figure[hidden]{display:none}.image-button{padding:0;border:0;display:block;position:relative;width:100%;aspect-ratio:3/4;overflow:hidden;background:#e2d9cd}.image-button img{width:100%;height:100%;object-fit:cover;transition:transform .45s}.image-button:hover img{transform:scale(1.035)}.image-open{position:absolute;right:15px;bottom:15px;width:34px;height:34px;background:var(--paper);display:grid;place-items:center;font-size:22px}.gallery figcaption{display:flex;justify-content:space-between;gap:8px;align-items:center;padding-top:13px;font-size:12px}.gallery figcaption span:last-child{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.7px}.portfolio-count{text-align:center;color:var(--muted);font-size:11px;margin:35px 0 0}.contact{background:var(--wine);color:var(--paper);padding-block:85px}.contact-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:12%}.contact h2{font-size:clamp(39px,4vw,60px);margin-bottom:26px}.contact em{color:#e3c8b8}.contact .eyebrow{color:#e3c8b8}.contact-grid>div>p:not(.eyebrow){max-width:390px;font-size:14px;line-height:1.9;color:#e6d8d1}.contact-buttons{display:flex;align-items:center;gap:25px;margin-top:30px;flex-wrap:wrap}.cream{background:var(--paper);color:var(--wine);min-width:180px}.cream:hover{background:#e3c8b8}.call-link{font-size:12px;padding-block:14px;border-bottom:1px solid #b58c89}.contact-details{padding-top:10px;display:flex;flex-direction:column;gap:36px}.contact-details .eyebrow{display:block;margin-bottom:16px}.contact-details a{display:block;font-size:19px;line-height:1.6}.contact-details a span{font-size:19px;margin-left:14px}.contact-details a:hover{text-decoration:underline;text-underline-offset:5px}.contact-details p{font-size:12px;line-height:1.8;color:#e6d8d1;margin:12px 0 0}.contact-details>div:last-child a{font-size:15px;padding-block:5px}footer{display:flex;align-items:center;justify-content:space-between;gap:25px;padding-block:38px}footer .brand{font-size:28px}footer .brand span{font-size:7px}footer p{font-family:var(--serif);font-style:italic;color:var(--muted);font-size:15px;margin:0}footer>span{font-size:10px;color:var(--muted)}.skip{position:fixed;top:-80px;left:20px;padding:15px;background:var(--wine);color:white;z-index:20}.skip:focus{top:15px}.lightbox{border:0;background:#211c1a;color:var(--paper);padding:22px;max-width:94vw;max-height:95dvh;width:min(850px,94vw)}.lightbox::backdrop{background:#171210e8}.lightbox>img{display:block;margin:16px auto;max-height:69dvh;max-width:100%;object-fit:contain}.lightbox>p{text-align:center;font-size:13px;margin:15px 0}.close-lightbox{display:block;margin-left:auto}.lightbox button{background:transparent;color:var(--paper);border:1px solid #79675d;padding:12px 18px;min-height:44px}.lightbox-controls{display:flex;justify-content:space-between}.lightbox button:hover{background:#42352e}
 .biography{max-width:485px;font-size:14px;line-height:1.8}.biography p{margin-bottom:14px}.biography p:last-child{margin-bottom:0}.hero-copy:has(.biography) h1{font-size:clamp(46px,4.5vw,66px);letter-spacing:-2px;margin-bottom:22px}
 .arrow-icon{display:inline-block;flex-shrink:0;vertical-align:middle}.button>span{display:flex;align-items:center}.contact-details a .biography{max-width:485px;font-size:14px;line-height:1.8}.biography p{margin-bottom:14px}.biography p:last-child{margin-bottom:0}.hero-copy:has(.biography) h1{font-size:clamp(46px,4.5vw,66px);letter-spacing:-2px;margin-bottom:22px}
 .arrow-icon{width:15px;height:15px}.lightbox-controls button{display:inline-flex;align-items:center;gap:10px}.service-top{min-height:33px}.photo-label{border-left:2px solid var(--wine)}
